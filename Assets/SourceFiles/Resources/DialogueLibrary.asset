  - Id: radio_evac
    Speaker: 1
    LocalizationKey: dlg.radio_evac
    Text: "Voc\xEA ouviu. Prepare o heliponto e acenda o farol. Ele chega em minutos."
    Clip: {fileID: 0}
    Duration: 0
    Priority: 2
    Interrupt: 0
    Trigger: 0
    MissionId: 
    ObjectiveIndex: -1
    ItemId: 
    ItemCount: 0
    Once: 1
    Cooldown: 0
    MaxQueueTime: 20
