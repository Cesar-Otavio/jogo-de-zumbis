    Segments: []
  - Id: radio_final
    Speaker: 1
    LocalizationKey: dlg.radio_final
    Text: "A Aurora est\xE1 vindo. \xC9 ela, a coisa do laborat\xF3rio. Use a luz contra ela e aguente at\xE9 o helic\xF3ptero tocar o ch\xE3o!"
    Clip: {fileID: 0}
    Duration: 0
    Priority: 3
    Interrupt: 1
