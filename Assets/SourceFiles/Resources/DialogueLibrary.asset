  - Id: evac_sent
    Speaker: 2
    LocalizationKey: dlg.evac_sent
    Text: "Controle Aurora, aqui \xE9 \xC1guia 2. C\xF3digo recebido. Preparem a zona de pouso e acendam o farol."
    Clip: {fileID: 0}
    Duration: 0
    Priority: 2
    Interrupt: 0
    Trigger: 2
    MissionId: m_evac_prep
    ObjectiveIndex: 1
    ItemId: 
    ItemCount: 0
    Once: 1
    Cooldown: 0
    MaxQueueTime: 20
    RequireMissionActive: 0
    SkipIfPlayed: 
