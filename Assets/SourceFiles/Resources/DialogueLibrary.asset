  - Id: evac_codes
    Speaker: 1
    LocalizationKey: dlg.evac_codes
    Text: "AURORA-NOITE. \xC9 esse o c\xF3digo. Leve at\xE9 a esta\xE7\xE3o de r\xE1dio."
    Clip: {fileID: 0}
    Duration: 0
    Priority: 2
    Interrupt: 0
    Trigger: 5
